---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import Icon from '../components/Icon.astro';
import { ui, statusLabel } from '../i18n/ui';

const profileEntry = await getEntry('profile', 'main');
if (!profileEntry) throw new Error('src/content/data/profile.yaml 缺少顶层的 main 条目');
const profile = profileEntry.data;
const focusAreas = (await getCollection('focusAreas')).map((e) => e.data);
const interests = (await getCollection('interests')).map((e) => e.data);
const education = (await getCollection('education')).map((e) => e.data);
const honors = (await getCollection('honors')).map((e) => e.data);
// 稳定排序保留同一年内的 YAML 顺序；动态、计数和列表共用这一份数据。
const publications = (await getCollection('publications'))
	.map((e) => e.data)
	.sort((a, b) => Number(b.year) - Number(a.year))
	.map((p, i) => ({ ...p, anchor: `publication-${i + 1}` }));
const news = publications.filter((p) => Number(p.year) >= 2025);
const isLead = (status: string[]) => status.includes('first') || status.includes('cofirst');
const leadCount = publications.filter((p) => isLead(p.status)).length;
const pillClass = (status: string) => status === 'highlight' ? 'pill pill--gold' : 'pill pill--accent';
const label = (status: string) => statusLabel[status as keyof typeof statusLabel];
const interestIcons: Record<string, 'book' | 'camera' | 'film' | 'activity' | 'music'> = {
	Reading: 'book', Photography: 'camera', 'Movie & TV': 'film', Sports: 'activity', Music: 'music',
};
---

<BaseLayout
	titleEn="Bingxuan Zhao | Academic Homepage"
	titleZh="赵炳轩 | 个人主页"
	description="Bingxuan Zhao — Ph.D. candidate at Northwestern Polytechnical University working on computer vision, generative AI and remote sensing."
	layout="sidebar"
>
	<div slot="sidebar" class="profile">
		<div class="profile-card">
			<div class="profile-overline"><span class="status-dot" aria-hidden="true"></span><T en="RESEARCH & EXPLORATION" zh="科研与探索" /></div>
			<div class="avatar-wrap">
				<img class="avatar" src={profile.avatar} alt="Bingxuan Zhao" width="132" height="132" fetchpriority="high" />
				<span class="avatar-mark" aria-hidden="true"><Icon name="scholar" size={17} /></span>
			</div>
			<div class="profile-identity">
				<h1 class="profile-name"><T en={profile.name.en} zh={profile.name.zh} /></h1>
				<p class="profile-title"><T en={profile.title.en} zh={profile.title.zh} /></p>
				<p class="profile-org"><T en={profile.university.en} zh={profile.university.zh} /></p>
				<p class="profile-loc"><Icon name="pin" size={13} /><T en={profile.location.en} zh={profile.location.zh} /></p>
			</div>
			<p class="motto">{(profile.motto.match(/[^，。！？；]+[，。！？；]?/g) || [profile.motto]).map((clause) => <span>{clause}</span>)}</p>
			<div class="profile-contact">
				<a class="contact-button" href={`mailto:${profile.email}`}><Icon name="mail" size={16} /><T en="Get in touch" zh="联系我" /><Icon name="arrow" size={15} /></a>
				<a class="email-address" href={`mailto:${profile.email}`}>{profile.email}</a>
				<div class="social-links">
					<a href={profile.links.github} rel="noreferrer"><Icon name="github" size={15} />GitHub</a>
					<a href={profile.links.scholar} rel="noreferrer"><Icon name="scholar" size={17} /><T en="Scholar" zh="谷歌学术" /></a>
					{profile.links.cv && <a href={profile.links.cv}><Icon name="file" size={15} />CV</a>}
				</div>
			</div>
		</div>
		<div class="side-block">
			<h2 class="side-title"><span class="side-title-line" aria-hidden="true"></span><T en={ui.section.interests.en} zh={ui.section.interests.zh} /></h2>
			<ul class="interest-list">
				{interests.map((i) => <li>{i.link ? (
					<a href={i.link} rel="noreferrer"><Icon name={interestIcons[i.name.en] || 'book'} size={14} /><T en={i.name.en} zh={i.name.zh} /></a>
				) : <span><Icon name={interestIcons[i.name.en] || 'book'} size={14} /><T en={i.name.en} zh={i.name.zh} /></span>}</li>)}
			</ul>
		</div>
	</div>

	<section class="section about-section" id="about" aria-labelledby="about-title">
		<div class="eyebrow"><span aria-hidden="true"></span><T en="A LITTLE ABOUT ME" zh="关于我的研究" /></div>
		<h2 class="hero-title" id="about-title"><T en="Understanding vision.<br /><em>Exploring generation.</em>" zh="理解视觉世界，<br /><em>探索生成边界。</em>" /></h2>
		<T tag="p" class="lede" en={profile.bio.en} zh={profile.bio.zh} />
		<T tag="p" class="research-statement" en={profile.researchStatement.en} zh={profile.researchStatement.zh} />
		<div class="focus-tags" aria-label="Research interests">
			{focusAreas.map((f) => <span class="focus-tag"><T en={f.en} zh={f.zh} /></span>)}
		</div>
		<div class="hero-bottom">
			<a class="research-link" href="#publications"><T en="Explore my research" zh="浏览我的研究" /><span aria-hidden="true">↓</span></a>
			<span class="hero-note"><T en="Vision · Synthesis · Discovery" zh="视觉 · 生成 · 探索" /></span>
		</div>
	</section>

	<section class="section" id="news" aria-labelledby="news-title">
		<div class="section-head">
			<div class="section-heading"><span class="section-index" aria-hidden="true">01</span><h2 id="news-title"><T en={ui.section.news.en} zh={ui.section.news.zh} /></h2><span class="live-dot" aria-hidden="true"></span></div>
			{news.length > 3 && <button id="news-toggle" class="text-button" type="button" aria-controls="news-list" aria-expanded="false" hidden>
				<span data-state="collapsed"><T en="All updates" zh="全部动态" /> <span aria-hidden="true">↗</span></span>
				<span data-state="expanded" hidden><T en={ui.label.showLess.en} zh={ui.label.showLess.zh} /> <span aria-hidden="true">↑</span></span>
			</button>}
		</div>
		<ul class="news-list" id="news-list">
			{news.map((n, i) => <li data-extra={i >= 3 ? 'true' : 'false'}>
				<span class="news-year">{n.year}</span>
				<div class="news-body">
					<a class="news-title" href={`#${n.anchor}`}>{n.title}</a>
					<span class="news-detail"><T en="Accepted at" zh="录用于" /> <span class="news-venue" title={n.venue}>{n.venueShort}</span>{n.status.includes('highlight') && <span class="pill pill--gold">Highlight</span>}</span>
				</div>
				<Icon name="arrow" size={15} />
			</li>)}
		</ul>
	</section>

	<section class="section" id="publications" aria-labelledby="publications-title">
		<div class="section-head publication-heading">
			<div class="section-heading"><span class="section-index" aria-hidden="true">02</span><h2 id="publications-title"><T en={ui.section.publications.en} zh={ui.section.publications.zh} /></h2></div>
			<button id="pub-toggle" type="button" class="text-button pub-toggle" aria-controls="pub-list" aria-expanded="false" hidden>
				<span data-state="collapsed"><T en={`All ${publications.length} papers`} zh={`全部 ${publications.length} 篇`} /> <span aria-hidden="true">↗</span></span>
				<span data-state="expanded" hidden><T en="Selected only" zh="仅代表作" /> <span aria-hidden="true">↑</span></span>
			</button>
		</div>
		<div class="publication-caption"><T en="A selection of work on visual understanding and generation." zh="聚焦视觉理解与生成的研究工作。" /><span><span id="pub-count" aria-live="polite">{publications.length}</span> / {String(publications.length).padStart(2, '0')}</span></div>
		<ul class="pub-list" id="pub-list">
			{publications.map((p, i) => <li class:list={['pub', { 'pub--featured': i === 0, 'pub--no-image': !p.image }]} data-lead={isLead(p.status) ? 'true' : 'false'} id={p.anchor}>
				{p.image && <a class="pub-thumb" href={p.image} target="_blank" rel="noreferrer" aria-label={`View full research figure: ${p.title}`}>
					<img src={p.image} alt={p.title} loading="lazy" decoding="async" />
					<span class="figure-zoom"><Icon name="arrow" size={13} /><span class="sr-only"><T en="View full figure" zh="查看完整配图" /></span></span>
				</a>}
				<div class="pub-body">
					<div class="pub-meta"><span class="pub-venue" title={p.venue}>{p.venueShort} <span class="pub-year">{p.year}</span></span><div class="pub-badges">{p.status.map((s) => <span class={pillClass(s)}><T en={label(s).en} zh={label(s).zh} /></span>)}</div></div>
					<h3 class="pub-title">{p.title}</h3>
					<p class="pub-authors" set:html={p.authors} />
					<T tag="p" class="pub-desc" en={p.description.en} zh={p.description.zh} />
					{p.github && <a class="code-link" href={p.github} rel="noreferrer"><Icon name="github" size={13} /><T en={ui.label.code.en} zh={ui.label.code.zh} /><Icon name="arrow" size={12} /></a>}
				</div>
			</li>)}
		</ul>
		<a class="scholar-link" href={profile.links.scholar} rel="noreferrer"><Icon name="scholar" size={18} /><T en="Find all publications on Google Scholar" zh="在 Google Scholar 查看全部论文" /><Icon name="arrow" size={14} /></a>
	</section>

	<section class="section" id="education" aria-labelledby="education-title">
		<div class="section-head"><div class="section-heading"><span class="section-index" aria-hidden="true">03</span><h2 id="education-title"><T en={ui.section.education.en} zh={ui.section.education.zh} /></h2></div></div>
		<ul class="timeline">
			{education.map((e) => <li>
				<div class="school-mark">{e.logo ? <img class="school-logo" src={e.logo} alt="" width="44" height="44" loading="lazy" /> : <Icon name="scholar" size={26} />}</div>
				<div class="education-body">
					<div class="timeline-head"><h3><T en={e.school.en} zh={e.school.zh} /></h3><span class="meta"><T en={e.year.en} zh={e.year.zh} /></span></div>
					<T tag="p" class="timeline-degree" en={e.degree.en} zh={e.degree.zh} />
					<T tag="p" class="timeline-desc" en={e.description.en} zh={e.description.zh} />
				</div>
			</li>)}
		</ul>
	</section>

	<section class="section" id="honors" aria-labelledby="honors-title">
		<div class="section-head"><div class="section-heading"><span class="section-index" aria-hidden="true">04</span><h2 id="honors-title"><T en={ui.section.honors.en} zh={ui.section.honors.zh} /></h2></div></div>
		<ul class="honor-list">{honors.map((h) => <li>
			<span class="honor-star" aria-hidden="true">✧</span>
			<span class="honor-body"><span class="honor-title"><T en={h.title.en} zh={h.title.zh} /></span><span class="honor-issuer"><T en={h.issuer.en} zh={h.issuer.zh} /></span></span>
			<span class="honor-year">{h.year}</span>
		</li>)}</ul>
	</section>

	<section class="contact-note" aria-labelledby="contact-title">
		<div><h2 id="contact-title"><T en="Good research starts with a conversation." zh="让好的研究，从一次交流开始。" /></h2><T tag="p" en={profile.collaboration.en} zh={profile.collaboration.zh} /></div>
		<a href={`mailto:${profile.email}`} class="contact-arrow"><Icon name="arrow" size={24} /><span class="sr-only"><T en="Contact me by email" zh="通过邮件联系我" /></span></a>
	</section>
</BaseLayout>

<script is:inline define:vars={{ leadCount, totalCount: publications.length }}>
	(function () {
		function disclosure(buttonId, items, onChange) {
			var btn = document.getElementById(buttonId);
			if (!btn || !items.length) return null;
			var collapsedLabel = btn.querySelector('[data-state="collapsed"]');
			var expandedLabel = btn.querySelector('[data-state="expanded"]');
			function apply(expanded) {
				items.forEach(function (el) { el.hidden = !expanded; });
				collapsedLabel.hidden = expanded;
				expandedLabel.hidden = !expanded;
				btn.setAttribute('aria-expanded', String(expanded));
				if (onChange) onChange(expanded);
			}
			btn.hidden = false;
			apply(false);
			btn.addEventListener('click', function () { apply(btn.getAttribute('aria-expanded') !== 'true'); });
			return apply;
		}
		var expandPapers = disclosure('pub-toggle', document.querySelectorAll('.pub[data-lead="false"]'), function (expanded) {
			document.getElementById('pub-count').textContent = String(expanded ? totalCount : leadCount);
		});
		disclosure('news-toggle', document.querySelectorAll('.news-list [data-extra="true"]'));
		function revealPaper(hash) {
			if (!/^#publication-\d+$/.test(hash)) return;
			var paper = document.getElementById(hash.slice(1));
			if (paper && paper.hidden && expandPapers) expandPapers(true);
		}
		// 动态直达默认折叠的合作论文；直接访问论文锚点也能展开。
		document.querySelectorAll('.news-title').forEach(function (link) {
			link.addEventListener('click', function () { revealPaper(link.hash); });
		});
		window.addEventListener('hashchange', function () { revealPaper(location.hash); });
		revealPaper(location.hash);
	})();
</script>

<style>
	/* 字体仅含 motto 字符；修改句子后需重新裁剪（授权文件在 public/fonts）。
	   pyftsubset ZhiMangXing-Regular.ttf --text="新的句子" --flavor=woff2 \
	     --layout-features='' --no-hinting --output-file=zhimangxing-motto.woff2 */
	@font-face {
		font-family: 'ZhiMangXing Motto';
		src: url('/fonts/zhimangxing-motto.woff2') format('woff2');
		font-display: swap;
	}
	.profile-card { padding: 25px 23px 23px; border: 1px solid var(--border); border-radius: 16px; background: linear-gradient(160deg, var(--accent-soft), var(--surface) 48%); box-shadow: 0 8px 32px color-mix(in srgb, var(--text-strong) 3%, transparent); text-align: center; }
	.profile-overline { display: flex; align-items: center; justify-content: center; gap: 7px; font: 9px var(--font-mono); letter-spacing: .09em; color: var(--muted); margin-bottom: 27px; }
	.status-dot, .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #668570; flex-shrink: 0; }
	.avatar-wrap { position: relative; width: 132px; margin: 0 auto 20px; }
	.avatar { display: block; width: 132px; height: 132px; object-fit: cover; border-radius: 50%; border: 5px solid var(--surface); box-shadow: 0 0 0 1px var(--border); }
	.avatar-mark { position: absolute; bottom: 4px; right: 1px; display: grid; place-items: center; width: 29px; height: 29px; border: 3px solid var(--surface); border-radius: 50%; background: var(--accent); color: var(--surface); }
	.profile-name { font-size: 29px; letter-spacing: -.045em; margin: 0 0 10px; }
	.profile-name :global([data-l='zh']) { letter-spacing: .12em; }
	.profile-title { font-size: 12px; line-height: 1.65; color: var(--muted); margin: 0 auto 10px; max-width: 200px; }
	.profile-org { font-size: 12px; line-height: 1.65; color: var(--text-strong); margin: 0 0 12px; }
	.profile-loc { display: flex; align-items: center; justify-content: center; gap: 5px; font-size: 11px; color: var(--faint); margin: 0; }
	.motto { font-family: 'ZhiMangXing Motto', var(--font-serif); font-size: 20px; line-height: 1.65; color: var(--accent); border-block: 1px solid var(--border-soft); padding: 16px 0; margin: 18px 0; }
	.motto > span { display: inline-block; white-space: nowrap; }
	.contact-button { display: flex; align-items: center; justify-content: center; gap: 9px; background: var(--accent); color: var(--surface); border: 1px solid transparent; border-radius: 7px; padding: 10px; font-size: 12px; transition: opacity .2s, transform .2s; }
	.contact-button { white-space: nowrap; }
	.contact-button :global(svg) { flex-shrink: 0; }
	.contact-button :global(svg:last-child) { margin-left: auto; }
	.contact-button:hover { text-decoration: none; opacity: .88; transform: translateY(-1px); }
	.email-address { display: block; font-size: 10px; color: var(--muted); margin: 11px -4px 16px; overflow-wrap: anywhere; }
	.social-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 18px; }
	.social-links a { display: inline-flex; align-items: center; gap: 6px; color: var(--text); font-size: 11px; min-height: 30px; }
	.side-block { padding: 25px 7px 0; }
	.side-title { display: flex; align-items: center; gap: 8px; font: 10px var(--font-sans); text-transform: uppercase; letter-spacing: .12em; color: var(--faint); margin-bottom: 13px; }
	.side-title-line { width: 17px; height: 1px; background: var(--faint); }
	.interest-list { list-style: none; display: flex; flex-wrap: wrap; gap: 2px 15px; padding: 0; margin: 0; }
	.interest-list li > a, .interest-list li > span { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 11px; min-height: 32px; }
	.interest-list a:hover { color: var(--accent); }

	/* 杂志式首屏：留白、衬线标题与克制配色，无外部装饰资源。 */
	.about-section { padding-top: 10px; margin-bottom: 48px; }
	.eyebrow { display: flex; align-items: center; gap: 11px; color: var(--muted); font: 10px var(--font-mono); letter-spacing: .13em; margin-bottom: 24px; }
	.eyebrow > span:first-child { width: 25px; height: 1px; background: var(--accent); }
	.hero-title { font-size: clamp(36px, 3.6vw, 53px); line-height: 1.17; letter-spacing: -.045em; margin: 0 0 25px; }
	.hero-title :global(em) { font-weight: 400; color: var(--accent); }
	.hero-title :global([data-l='zh']) { font-size: .9em; letter-spacing: .035em; line-height: 1.45; }
	.lede { font-size: 15px; line-height: 1.85; max-width: 660px; margin-bottom: 13px; }
	.lede :global(strong) { font-weight: 600; color: var(--text-strong); }
	.research-statement { color: var(--muted); font-size: 14px; line-height: 1.85; max-width: 660px; margin-bottom: 22px; }
	.focus-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 27px; }
	.focus-tag { color: var(--accent); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 9%, transparent); border-radius: 5px; font-size: 10px; padding: 4px 10px; }
	.hero-bottom { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding-top: 20px; border-top: 1px solid var(--border); }
	.research-link { display: flex; align-items: center; gap: 22px; font-size: 12px; font-weight: 500; min-height: 25px; }
	.research-link > span:last-child { font-size: 18px; transition: transform .2s; }
	.research-link:hover > span:last-child { transform: translateY(3px); }
	.hero-note { font: 9px var(--font-mono); color: var(--faint); }

	.news-list { list-style: none; margin: 0; padding: 0; }
	.news-list li { display: grid; grid-template-columns: 44px minmax(0, 1fr) 16px; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--border-soft); align-items: start; }
	.news-list li:first-child { padding-top: 0; }
	.news-list li:last-child { border-bottom: 0; padding-bottom: 0; }
	.news-year { font: 11px var(--font-mono); color: var(--faint); padding-top: 4px; }
	.news-title { display: block; font-size: 13px; line-height: 1.7; font-weight: 500; color: var(--text-strong); }
	.news-detail { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 11px; color: var(--muted); margin-top: 3px; }
	.news-venue { font-weight: 500; color: var(--accent); }
	.news-list li > :global(svg) { margin-top: 4px; color: var(--faint); }
	.live-dot { margin-left: 2px; box-shadow: 0 0 0 4px var(--accent-soft); }

	.publication-caption { display: flex; justify-content: space-between; align-items: center; gap: 20px; color: var(--muted); font-size: 12px; margin: -7px 0 22px; }
	.publication-caption > span:last-child { white-space: nowrap; font: 10px var(--font-mono); color: var(--faint); }
	.pub-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }
	.pub { display: grid; grid-template-columns: 202px minmax(0, 1fr); align-items: center; gap: 23px; padding: 23px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; transition: border-color .2s, box-shadow .2s, transform .2s; scroll-margin-top: 12px; }
	.pub--featured { border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); }
	.pub--no-image { grid-template-columns: 1fr; }
	.pub:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); box-shadow: var(--shadow-card); transform: translateY(-2px); }
	.pub-thumb { display: flex; position: relative; aspect-ratio: 4 / 3; background: #fff; border: 1px solid #edf0ec; border-radius: 7px; overflow: hidden; align-items: center; }
	.pub-thumb img { display: block; width: 100%; height: 100%; object-fit: contain; padding: 6px; transition: transform .35s; }
	.pub-thumb:hover img { transform: scale(1.035); }
	.figure-zoom { position: absolute; bottom: 6px; right: 6px; display: grid; place-items: center; width: 23px; height: 23px; background: #f5f7f2; color: #385b47; border: 1px solid #dce2d8; border-radius: 4px; }
	.pub-body { min-width: 0; }
	.pub-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 9px; }
	.pub-venue { font: 600 10px var(--font-sans); letter-spacing: .035em; color: var(--accent); }
	.pub-year { margin-left: 5px; font: 10px var(--font-mono); color: var(--faint); }
	.pub-badges { display: flex; flex-wrap: wrap; gap: 5px; margin-left: auto; }
	.pub-badges .pill { font-size: 9px; padding: 2px 5px; }
	.pub-title { font-size: 18px; font-weight: 500; line-height: 1.4; letter-spacing: -.015em; margin: 0 0 9px; overflow-wrap: anywhere; }
	.pub-authors { font-size: 12px; line-height: 1.7; color: var(--muted); margin: 0 0 9px; }
	.pub-authors :global(strong) { color: var(--text-strong); font-weight: 600; }
	.pub-desc { color: var(--muted); font-size: 13px; line-height: 1.75; margin: 0 0 11px; }
	.code-link { display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; border: 1px solid var(--border); border-radius: 5px; font-size: 10px; min-height: 27px; }
	.code-link:hover { text-decoration: none; background: var(--accent-soft); border-color: var(--accent); }
