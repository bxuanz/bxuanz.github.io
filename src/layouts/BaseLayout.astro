---
import T from '../components/T.astro';
import { ui } from '../i18n/ui';

interface Props {
	titleEn: string;
	titleZh: string;
	description?: string;
	/** 首页用双栏（侧栏+正文），内页用单栏窄版 */
	layout?: 'sidebar' | 'narrow';
}

const {
	titleEn,
	titleZh,
	description = 'Bingxuan Zhao — academic homepage.',
	layout = 'narrow',
} = Astro.props;

const path = Astro.url.pathname;
const homeAnchor = (id: string) => `${path === '/' ? '' : '/'}#${id}`;
const nav = [
	{ id: 'about', label: ui.nav.about },
	{ id: 'news', label: ui.nav.news },
	{ id: 'publications', label: ui.nav.publications },
	{ id: 'education', label: ui.nav.education },
	{ id: 'honors', label: ui.nav.honors },
];
---

<!doctype html>
<html lang="en" data-lang="en" data-title-en={titleEn} data-title-zh={titleZh}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=avatar-1" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=avatar-1" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<title>{titleEn}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={titleEn} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="canonical" href={new URL(path, Astro.site)} />

		<script is:inline>
			// Resolve preferences before first paint; CSS also supports a no-JS system theme.
			(function () {
				var root = document.documentElement;
				var lang = 'en';
				var theme = null;
				try {
					var savedLang = localStorage.getItem('lang');
					if (savedLang === 'zh' || savedLang === 'en') lang = savedLang;
					theme = localStorage.getItem('theme');
				} catch (e) {
					/* Preferences remain usable when storage is unavailable. */
				}
				root.dataset.lang = lang;
				root.lang = lang === 'zh' ? 'zh-CN' : 'en';
				root.dataset.theme = theme === 'light' || theme === 'dark'
					? theme
					: window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				var title = root.getAttribute(lang === 'zh' ? 'data-title-zh' : 'data-title-en');
				if (title) document.title = title;
			})();
		</script>
	</head>

	<body>
		<a class="skip" href="#main"><T en="Skip to content" zh="跳到主内容" /></a>

		<header class="topbar">
			<div class="topbar-inner">
				<a class="brand" href="/">
					<span class="brand-mark" aria-hidden="true">bz.</span>
					<span class="brand-name"><T en="Bingxuan Zhao" zh="赵炳轩" /></span>
				</a>

				<nav class="site-nav" aria-label="Main navigation">
					{
						nav.map((item) => (
							<a href={homeAnchor(item.id)} data-section={item.id}>
								<T en={item.label.en} zh={item.label.zh} />
							</a>
						))
					}
				</nav>

				<div class="header-controls" hidden>
					<button
						id="theme-toggle"
						type="button"
						class="theme-btn"
						aria-label="Switch to dark theme"
					>
						<svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							<path d="M20.9 13.1A9 9 0 0 1 10.9 3.1 9 9 0 1 0 20.9 13.1Z" />
						</svg>
						<svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
							<circle cx="12" cy="12" r="4" />
							<path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
						</svg>
					</button>
					<button id="lang-toggle" type="button" class="lang-btn" aria-label="Switch to Chinese">
						<T en="中" zh="EN" />
					</button>
				</div>
			</div>
		</header>

		<div class={layout === 'sidebar' ? 'shell shell--sidebar' : 'shell shell--narrow'}>
			{
				layout === 'sidebar' && (
					<aside class="sidebar">
						<slot name="sidebar" />
					</aside>
				)
			}
			<main id="main" tabindex="-1">
				<slot />

				<footer class="footer">
					<p>
						© {new Date().getFullYear()} <T en="Bingxuan Zhao" zh="赵炳轩" />
						<span class="footer-dot" aria-hidden="true">·</span>
						<span><T en="Built with" zh="基于" /> <a href="https://astro.build/">Astro</a><T en="" zh="构建" /></span>
					</p>
					<a class="back-to-top" href={homeAnchor('about')}>
						<T en="Back to top" zh="返回顶部" />
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							<path d="M12 19V5m-6 6 6-6 6 6" />
						</svg>
					</a>
				</footer>
			</main>
		</div>

		<script is:inline>
			(function () {
				var root = document.documentElement;
				var langButton = document.getElementById('lang-toggle');
				var themeButton = document.getElementById('theme-toggle');
				var controls = document.querySelector('.header-controls');
				var navigation = document.querySelector('.site-nav');
				var systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
				var followsSystem = true;
				try {
					var savedTheme = localStorage.getItem('theme');
					followsSystem = savedTheme !== 'light' && savedTheme !== 'dark';
				} catch (e) {
					/* Keep the system preference until the user chooses a theme. */
				}

				function updateLabels() {
					var chinese = root.dataset.lang === 'zh';
					var dark = root.dataset.theme === 'dark';
					var langLabel = chinese ? '切换为英文' : 'Switch to Chinese';
					var themeLabel = chinese
						? dark ? '切换为浅色主题' : '切换为深色主题'
						: dark ? 'Switch to light theme' : 'Switch to dark theme';
					if (langButton) {
						langButton.setAttribute('aria-label', langLabel);
						langButton.title = langLabel;
					}
					if (themeButton) {
						themeButton.setAttribute('aria-label', themeLabel);
						themeButton.title = themeLabel;
					}
					if (navigation) navigation.setAttribute('aria-label', chinese ? '主导航' : 'Main navigation');
				}

				function savePreference(key, value) {
					try {
						localStorage.setItem(key, value);
					} catch (e) {
						/* The current page still reflects the selected preference. */
					}
				}

				if (langButton) langButton.addEventListener('click', function () {
					var next = root.dataset.lang === 'zh' ? 'en' : 'zh';
					root.dataset.lang = next;
					root.lang = next === 'zh' ? 'zh-CN' : 'en';
					var title = root.getAttribute(next === 'zh' ? 'data-title-zh' : 'data-title-en');
					if (title) document.title = title;
					var ogTitle = document.querySelector('meta[property="og:title"]');
					if (title && ogTitle) ogTitle.setAttribute('content', title);
					savePreference('lang', next);
					updateLabels();
					scheduleScrollspy();
				});

				if (themeButton) themeButton.addEventListener('click', function () {
					var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
					root.dataset.theme = next;
					followsSystem = false;
					savePreference('theme', next);
					updateLabels();
				});

				function onSystemThemeChange(event) {
					if (!followsSystem) return;
					root.dataset.theme = event.matches ? 'dark' : 'light';
					updateLabels();
				}
				if (systemTheme.addEventListener) {
					systemTheme.addEventListener('change', onSystemThemeChange);
				} else {
					systemTheme.addListener(onSystemThemeChange);
				}
				updateLabels();
				if (controls) controls.hidden = false;

				// Native anchors remain intact. Scrollspy only annotates navigation links.
				var header = document.querySelector('.topbar');
				var links = Array.from(document.querySelectorAll('.site-nav a[data-section]'));
				var sections = links.map(function (link) {
					return { link: link, section: document.getElementById(link.dataset.section) };
				}).filter(function (entry) { return entry.section; });
				var scheduled = false;

				function updateScrollspy() {
					scheduled = false;
					if (!sections.length) return;
					var offset = (header ? header.getBoundingClientRect().bottom : 0) + 24;
					var positions = sections.map(function (entry) {
						return { link: entry.link, top: entry.section.getBoundingClientRect().top };
					}).sort(function (a, b) { return a.top - b.top; });
					var active = positions[0].link;
					positions.forEach(function (entry) {
						if (entry.top <= offset + 1) active = entry.link;
					});
					if (root.scrollHeight > window.innerHeight + 1 &&
						window.scrollY + window.innerHeight >= root.scrollHeight - 2) {
						active = positions[positions.length - 1].link;
					}
					links.forEach(function (link) {
						if (link === active) link.setAttribute('aria-current', 'location');
						else link.removeAttribute('aria-current');
					});
				}

				function scheduleScrollspy() {
					if (scheduled) return;
					scheduled = true;
					window.requestAnimationFrame(updateScrollspy);
				}
				window.addEventListener('scroll', scheduleScrollspy, { passive: true });
				window.addEventListener('resize', scheduleScrollspy);
				window.addEventListener('hashchange', scheduleScrollspy);
				window.addEventListener('load', scheduleScrollspy);
				if ('ResizeObserver' in window) {
					var observer = new ResizeObserver(scheduleScrollspy);
					sections.forEach(function (entry) { observer.observe(entry.section); });
					var main = document.getElementById('main');
					if (main) observer.observe(main);
				}
				if (document.fonts) document.fonts.ready.then(scheduleScrollspy);
				scheduleScrollspy();
			})();
		</script>

		<style is:global>
			:root {
				--bg: #f7f7f2;
				--bg-tint: #eeefe8;
				--surface: #ffffff;
				--text: #46514a;
				--text-strong: #23382d;
				--muted: #626e65;
				--faint: #69746c;
				--accent: #385b47;
				--accent-soft: #eaf0e9;
				--border: #dce2d8;
				--border-soft: #e8ece4;
				--gold: #8a671b;
				--font-serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, 'Songti SC', 'Noto Serif SC', serif;
				--font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Helvetica, Arial, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
				--font-mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
				--radius: 16px;
				--radius-sm: 8px;
				--shadow-card: 0 1px 3px rgb(35 56 45 / 3%), 0 8px 28px rgb(35 56 45 / 4%);
				--shadow-lift: 0 3px 8px rgb(35 56 45 / 5%), 0 16px 40px rgb(35 56 45 / 8%);
				--sidebar-w: 264px;
				--content-max: 1220px;
				--narrow-max: 46rem;
				--page-padding: 32px;
				--header-height: 80px;
				color-scheme: light;
			}

			:root[data-theme='dark'] {
				--bg: #111a15;
				--bg-tint: #17221b;
				--surface: #1c2921;
				--text: #c1cec2;
				--text-strong: #e5eee2;
				--muted: #a0b1a2;
				--faint: #90a292;
				--accent: #a8c7a5;
				--accent-soft: #24392b;
				--border: #344638;
				--border-soft: #29392e;
				--gold: #dcc17c;
				--shadow-card: 0 1px 3px rgb(0 0 0 / 12%), 0 8px 28px rgb(0 0 0 / 16%);
				--shadow-lift: 0 3px 8px rgb(0 0 0 / 18%), 0 16px 40px rgb(0 0 0 / 24%);
				color-scheme: dark;
			}

			@media (prefers-color-scheme: dark) {
				:root:not([data-theme]) {
					--bg: #111a15;
					--bg-tint: #17221b;
					--surface: #1c2921;
					--text: #c1cec2;
					--text-strong: #e5eee2;
					--muted: #a0b1a2;
					--faint: #90a292;
					--accent: #a8c7a5;
					--accent-soft: #24392b;
					--border: #344638;
					--border-soft: #29392e;
					--gold: #dcc17c;
					--shadow-card: 0 1px 3px rgb(0 0 0 / 12%), 0 8px 28px rgb(0 0 0 / 16%);
					--shadow-lift: 0 3px 8px rgb(0 0 0 / 18%), 0 16px 40px rgb(0 0 0 / 24%);
					color-scheme: dark;
				}
			}

			html[data-lang='en'] [data-l='zh'],
			html[data-lang='zh'] [data-l='en'],
			[hidden] {
				display: none !important;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				-webkit-text-size-adjust: 100%;
				scroll-behavior: smooth;
				scroll-padding-top: calc(var(--header-height) + 24px);
				overscroll-behavior-y: none;
			}

			body {
				margin: 0;
				min-width: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				overflow-x: clip;
				background: var(--bg);
				color: var(--text);
				font-family: var(--font-sans);
				font-size: 15px;
				line-height: 1.75;
				overflow-wrap: anywhere;
				text-rendering: optimizeLegibility;
				-webkit-font-smoothing: antialiased;
			}

			html[data-lang='zh'] body {
				line-height: 1.9;
			}

			a {
				color: var(--accent);
				text-decoration: none;
				text-underline-offset: 0.22em;
				text-decoration-thickness: 1px;
			}

			a:hover,
			a:focus-visible {
				text-decoration: underline;
			}

			:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 4px;
				border-radius: 3px;
			}

			button,
			input,
			select,
			textarea {
				font: inherit;
			}

			button {
				color: inherit;
			}

			h1,
			h2,
			h3 {
				margin: 0 0 0.5em;
				font-family: var(--font-serif);
				font-weight: 400;
				line-height: 1.25;
				letter-spacing: -0.025em;
				color: var(--text-strong);
			}

			h1 { font-size: clamp(36px, 5vw, 52px); }
			h2 { font-size: 28px; }
			h3 { font-size: 22px; }
			strong, b { font-weight: 600; }
			p { margin: 0 0 1.05em; }

			img,
			video,
			iframe {
				max-width: 100%;
			}

			img,
			video {
				height: auto;
			}

			hr {
				border: 0;
				border-top: 1px solid var(--border);
				margin: 40px 0;
			}

			code {
				font-family: var(--font-mono);
				font-size: 0.87em;
				background: var(--accent-soft);
				padding: 0.12em 0.38em;
				border-radius: 4px;
			}

			pre {
				max-width: 100%;
				background: var(--bg-tint) !important;
				border: 1px solid var(--border);
				border-radius: var(--radius-sm);
				padding: 16px 18px;
				overflow-x: auto;
			}

			pre code {
				background: none;
				padding: 0;
				font-size: 0.84em;
			}

			blockquote {
				margin: 24px 0;
				padding: 2px 0 2px 18px;
				border-left: 2px solid var(--accent);
				color: var(--muted);
			}

			table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.93em;
				margin: 24px 0;
			}

			th,
			td {
				text-align: left;
				padding: 9px 12px;
				border-bottom: 1px solid var(--border-soft);
			}

			th {
				font-weight: 600;
				color: var(--text-strong);
				background: var(--bg-tint);
			}

			.sr-only,
			.skip:not(:focus) {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip-path: inset(50%);
				white-space: nowrap;
				border: 0;
			}

			.skip:focus {
				position: fixed;
				left: 20px;
				top: 16px;
				z-index: 30;
				background: var(--surface);
				padding: 8px 14px;
				border: 1px solid var(--border);
				border-radius: var(--radius-sm);
			}

			.topbar {
				position: sticky;
				top: 0;
				z-index: 20;
				height: var(--header-height);
				flex-shrink: 0;
				background: var(--bg);
				border-bottom: 1px solid var(--border-soft);
			}

			@supports ((backdrop-filter: blur(16px)) or (-webkit-backdrop-filter: blur(16px))) {
				.topbar {
					background: color-mix(in srgb, var(--bg) 88%, transparent);
					-webkit-backdrop-filter: saturate(1.2) blur(16px);
					backdrop-filter: saturate(1.2) blur(16px);
				}
			}

			.topbar-inner {
				max-width: var(--content-max);
				height: 100%;
				margin-inline: auto;
				padding-inline: var(--page-padding);
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
				grid-template-areas: 'brand nav controls';
				align-items: center;
				column-gap: 24px;
			}

			.brand {
				grid-area: brand;
				justify-self: start;
				display: inline-flex;
				align-items: center;
				gap: 12px;
				min-width: 0;
				font-family: var(--font-serif);
				font-size: 21px;
				line-height: 1.2;
				letter-spacing: -0.035em;
				color: var(--text-strong);
			}

			.brand:hover {
				text-decoration: none;
				color: var(--accent);
			}

			.brand-mark {
				display: grid;
				place-items: center;
				flex: 0 0 32px;
				width: 32px;
				height: 32px;
				padding-bottom: 2px;
				border-radius: 9px;
				background: #385b47;
				color: #f7f7f2;
				font-size: 21px;
				letter-spacing: -0.06em;
			}

			.site-nav {
				grid-area: nav;
				display: flex;
				align-items: center;
				gap: 24px;
				min-width: 0;
			}

			.site-nav a {
				position: relative;
				display: inline-flex;
				align-items: center;
				flex-shrink: 0;
				min-height: 44px;
				font-size: 12px;
				font-weight: 500;
				letter-spacing: 0.025em;
				white-space: nowrap;
				color: var(--muted);
				transition: color 160ms ease;
			}

			.site-nav a::after {
				content: '';
				position: absolute;
				inset-inline: 0;
				bottom: 3px;
				height: 2px;
				background: var(--accent);
				transform: scaleX(0);
				transform-origin: left;
				transition: transform 160ms ease;
			}

			.site-nav a:hover,
			.site-nav a[aria-current='location'] {
				color: var(--accent);
				text-decoration: none;
			}

			.site-nav a[aria-current='location']::after {
				transform: scaleX(1);
			}

			.header-controls {
				grid-area: controls;
				justify-self: end;
				display: flex;
				align-items: center;
				gap: 6px;
			}

			.lang-btn,
			.theme-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 44px;
				min-width: 44px;
				height: 40px;
				padding: 0;
				border: 1px solid var(--border);
				border-radius: var(--radius-sm);
				background: transparent;
				color: var(--accent);
				font-family: var(--font-sans);
				font-size: 12px;
				font-weight: 500;
				line-height: 1;
				cursor: pointer;
				transition: background 160ms ease, border-color 160ms ease;
			}

			.lang-btn:hover,
			.theme-btn:hover {
				background: var(--accent-soft);
				border-color: var(--accent);
			}

			.theme-icon--sun,
			:root[data-theme='dark'] .theme-icon--moon {
				display: none;
			}

			:root[data-theme='dark'] .theme-icon--sun {
				display: block;
			}

			.shell {
				flex: 1;
				width: 100%;
				margin-inline: auto;
				padding: 48px var(--page-padding) 64px;
			}

			.shell--narrow {
				max-width: calc(var(--narrow-max) + var(--page-padding) * 2);
			}

			.shell--sidebar {
				max-width: var(--content-max);
				display: grid;
				grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
				gap: 56px;
				align-items: start;
				padding-bottom: 0;
			}

			.shell--sidebar main {
				padding-bottom: 64px;
			}

			main,
			.sidebar {
				min-width: 0;
			}

			.sidebar {
				position: sticky;
				/* Matches its initial position: 80px header + 48px shell padding. */
				top: 128px;
			}

			.footer {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 12px 24px;
				margin-top: 64px;
				padding-top: 24px;
				border-top: 1px solid var(--border);
				color: var(--muted);
				font-size: 11px;
			}

			.footer p {
				margin: 0;
			}

			.footer-dot {
				margin-inline: 8px;
				color: var(--faint);
			}

			.back-to-top {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				min-height: 40px;
				white-space: nowrap;
			}

			.section {
				margin-bottom: 64px;
			}

			.section:last-child {
				margin-bottom: 0;
			}

			.section-head {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 12px;
				border-bottom: 1px solid var(--border);
				padding-bottom: 16px;
				margin-bottom: 24px;
			}

			.section-head h2 {
				margin: 0;
				font-size: 28px;
				font-weight: 400;
			}

			.section-heading {
				display: flex;
				align-items: baseline;
				gap: 12px;
				min-width: 0;
			}

			.section-index {
				flex-shrink: 0;
				font-family: var(--font-mono);
				font-size: 10px;
				font-weight: 400;
				letter-spacing: 0.04em;
				color: var(--faint);
			}

			.section-head .text-button {
				margin-left: auto;
			}

			.pill {
				display: inline-block;
				max-width: 100%;
				font-size: 11px;
				font-weight: 500;
				line-height: 1.5;
				padding: 3px 7px;
				border-radius: 6px;
				border: 1px solid var(--border);
				color: var(--muted);
				background: var(--bg-tint);
				vertical-align: middle;
			}

			.pill--accent {
				color: var(--accent);
				border-color: color-mix(in srgb, var(--accent) 20%, var(--border-soft));
				background: var(--accent-soft);
			}

			.pill--gold {
				color: var(--gold);
				border-color: color-mix(in srgb, var(--gold) 25%, var(--border-soft));
				background: color-mix(in srgb, var(--gold) 9%, var(--bg));
			}

			.text-button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 6px;
				min-height: 40px;
				padding: 0;
				border: 0;
				background: transparent;
				color: var(--accent);
				font-family: var(--font-sans);
				font-size: 12px;
				line-height: 1.5;
				cursor: pointer;
				text-underline-offset: 0.22em;
			}

			.text-button:hover,
			.text-button:focus-visible {
				text-decoration: underline;
			}

			.meta {
				color: var(--muted);
				font-size: 12px;
				font-variant-numeric: tabular-nums;
			}

			@media (max-height: 900px) {
				.sidebar {
					position: static;
				}
			}

			@media (max-width: 900px) {
				:root {
					--header-height: 116px;
				}

				.topbar-inner {
					grid-template-columns: minmax(0, 1fr) auto;
					grid-template-rows: 71px 44px;
					grid-template-areas: 'brand controls' 'nav nav';
					column-gap: 12px;
				}

				.site-nav {
					align-self: stretch;
					gap: 28px;
					overflow-x: auto;
					overscroll-behavior-x: contain;
					scrollbar-width: none;
				}

				.site-nav::-webkit-scrollbar {
					display: none;
				}

				.site-nav a:focus-visible {
					outline-offset: -3px;
				}

				.shell--sidebar {
					grid-template-columns: minmax(0, 1fr);
					gap: 32px;
				}

				.sidebar {
					position: static;
				}

				table {
					display: block;
					max-width: 100%;
					overflow-x: auto;
				}
			}

			@media (max-width: 600px) {
				:root {
					--page-padding: 20px;
				}

				.brand {
					gap: 10px;
					font-size: 20px;
				}

				.site-nav {
					gap: 18px;
				}

				.shell {
					padding-top: 28px;
				}

				.footer {
					gap: 8px 16px;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}

				*,
				*::before,
				*::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
					scroll-behavior: auto !important;
				}
			}
		</style>
	</body>
</html>
