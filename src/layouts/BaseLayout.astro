---
import T from '../components/T.astro';
import { ui } from '../i18n/ui';

interface Props {
	titleEn: string;
	titleZh: string;
	description?: string;
	/** 首页用双栏（侧栏+正文），内页用单栏窄版 */
	layout?: 'sidebar' | 'narrow';
}

const {
	titleEn,
	titleZh,
	description = 'Bingxuan Zhao — academic homepage.',
	layout = 'narrow',
} = Astro.props;

const path = Astro.url.pathname;

// 单页站，导航是页内锚点。锚点对应 index.astro 里各 section 的 id。
// 「研究之外」不在这里：它在粘性侧栏里始终可见，不需要锚点。
const nav = [
	{ href: '#about', label: ui.nav.about },
	{ href: '#news', label: ui.nav.news },
	{ href: '#publications', label: ui.nav.publications },
	{ href: '#education', label: ui.nav.education },
	{ href: '#honors', label: ui.nav.honors },
];
---

<!doctype html>
<html lang="en" data-lang="en" data-title-en={titleEn} data-title-zh={titleZh}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{titleEn}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={titleEn} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="canonical" href={new URL(path, Astro.site)} />

		<script is:inline>
			// 在首次绘制前确定语言，避免切换时闪屏
			(function () {
				var el = document.documentElement;
				var saved = null;
				try {
					saved = localStorage.getItem('lang');
				} catch (e) {
					/* 隐私模式下 localStorage 可能不可用 */
				}
				var lang = saved === 'zh' || saved === 'en' ? saved : 'en';
				el.dataset.lang = lang;
				el.setAttribute('lang', lang === 'zh' ? 'zh-CN' : 'en');
				var t = el.getAttribute(
					lang === 'zh' ? 'data-title-zh' : 'data-title-en',
				);
				if (t) document.title = t;
			})();
		</script>
	</head>

	<body>
		<a class="skip" href="#main"><T en="Skip to content" zh="跳到主内容" /></a>

		<header class="topbar">
			<div class="topbar-inner">
				<a class="brand" href="/"><T en="Bingxuan Zhao" zh="赵炳轩" /></a>

				<nav aria-label="Site">
					{
						nav.map((item) => (
							<a href={item.href}>
								<T en={item.label.en} zh={item.label.zh} />
							</a>
						))
					}
					<button
						id="lang-toggle"
						type="button"
						class="lang-btn"
						aria-label="Switch language"
					>
						<T en={ui.label.langSwitch.en} zh={ui.label.langSwitch.zh} />
					</button>
				</nav>
			</div>
		</header>

		<div
			class={layout === 'sidebar' ? 'shell shell--sidebar' : 'shell shell--narrow'}
		>
			{
				layout === 'sidebar' && (
					<aside class="sidebar">
						<slot name="sidebar" />
					</aside>
				)
			}
			<main id="main">
				<slot />

				<footer class="footer">
					<p>
						© {new Date().getFullYear()} <T en="Bingxuan Zhao" zh="赵炳轩" /> ·{' '}
						<T en={ui.footer.builtWith.en} zh={ui.footer.builtWith.zh} />
					</p>
					{/* TODO 备案通过后填入备案号，内地网站需在页脚展示 */}
				</footer>
			</main>
		</div>

		<script is:inline>
			(function () {
				var btn = document.getElementById('lang-toggle');
				if (!btn) return;
				btn.addEventListener('click', function () {
					var el = document.documentElement;
					var next = el.dataset.lang === 'zh' ? 'en' : 'zh';
					el.dataset.lang = next;
					el.setAttribute('lang', next === 'zh' ? 'zh-CN' : 'en');
					var t = el.getAttribute(
						next === 'zh' ? 'data-title-zh' : 'data-title-en',
					);
					if (t) document.title = t;
					try {
						localStorage.setItem('lang', next);
					} catch (e) {
						/* 忽略写入失败 */
					}
				});
			})();
		</script>

		<style is:global>
			/* ───────────────────────── 设计变量 ───────────────────────── */
			:root {
				--bg: #f7f7f6;
				--bg-tint: #fdfdfc;
				--surface: #ffffff;
				--text: #33383f;
				--text-strong: #1f242b;
				--muted: #6f7681;
				--faint: #9aa0aa;
				--accent: #24528f;
				--accent-soft: rgba(36, 82, 143, 0.08);
				--border: #e5e7ea;
				--border-soft: #eeeff1;
				--shadow-card:
					0 1px 2px rgba(25, 39, 62, 0.04), 0 8px 24px rgba(25, 39, 62, 0.05);
				--shadow-lift:
					0 2px 6px rgba(25, 39, 62, 0.06), 0 16px 40px rgba(25, 39, 62, 0.09);

				--font-serif:
					'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua',
					Georgia, 'Songti SC', 'Noto Serif SC', serif;
				--font-sans:
					-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue',
					Helvetica, Arial, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei',
					sans-serif;
				--font-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;

				--radius: 14px;
				--radius-sm: 9px;
				--sidebar-w: 288px;
				--content-max: 1160px;
				--narrow-max: 46rem;

				color-scheme: light dark;
			}

			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #14161a;
					--bg-tint: #191c21;
					--surface: #1d2126;
					--text: #d9dce1;
					--text-strong: #f0f2f4;
					--muted: #969ca6;
					--faint: #767c86;
					--accent: #7aa7e0;
					--accent-soft: rgba(122, 167, 224, 0.12);
					--border: #2c3138;
					--border-soft: #24282e;
					--shadow-card:
						0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 24px rgba(0, 0, 0, 0.24);
					--shadow-lift:
						0 2px 6px rgba(0, 0, 0, 0.34), 0 16px 40px rgba(0, 0, 0, 0.34);
				}
			}

			/* ─────────────── 语言切换：隐藏非当前语言的文本 ─────────────── */
			html[data-lang='en'] [data-l='zh'],
			html[data-lang='zh'] [data-l='en'] {
				display: none !important;
			}

			/* ───────────────────────── 基础 ───────────────────────── */
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				-webkit-text-size-adjust: 100%;
				scroll-behavior: smooth;
				scroll-padding-top: 5rem;
				/* 关掉 macOS 的橡皮筋回弹：滚到底再滑会把整个文档拉过界再弹回来，
				   粘性侧栏在回弹里会跟着晃。到底就停死。 */
				overscroll-behavior-y: none;
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				background: var(--bg);
				color: var(--text);
				font-family: var(--font-sans);
				font-size: 16px;
				line-height: 1.72;
				letter-spacing: 0.01em;
				text-rendering: optimizeLegibility;
				-webkit-font-smoothing: antialiased;
			}

			/* 汉字需要更松的行距才舒展 */
			html[data-lang='zh'] body {
				line-height: 1.85;
			}

			a {
				color: var(--accent);
				text-decoration: none;
			}

			a:hover {
				text-decoration: underline;
				text-underline-offset: 0.2em;
			}

			:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 3px;
				border-radius: 3px;
			}

			h1,
			h2,
			h3,
			h4 {
				font-family: var(--font-serif);
				color: var(--text-strong);
				line-height: 1.28;
				letter-spacing: -0.005em;
				margin: 0 0 0.5em;
				font-weight: 600;
			}

			p {
				margin: 0 0 1.05em;
			}

			img {
				max-width: 100%;
				height: auto;
			}

			hr {
				border: 0;
				border-top: 1px solid var(--border);
				margin: 2.5rem 0;
			}

			code {
				font-family: var(--font-mono);
				font-size: 0.87em;
				background: var(--accent-soft);
				padding: 0.12em 0.38em;
				border-radius: 4px;
			}

			pre {
				background: var(--bg-tint) !important;
				border: 1px solid var(--border);
				border-radius: var(--radius-sm);
				padding: 1rem 1.1rem;
				overflow-x: auto;
			}

			pre code {
				background: none;
				padding: 0;
				font-size: 0.84em;
			}

			blockquote {
				margin: 1.4rem 0;
				padding: 0.1rem 0 0.1rem 1.1rem;
				border-left: 3px solid var(--border);
				color: var(--muted);
			}

			table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.93em;
				margin: 1.4rem 0;
			}

			th,
			td {
				text-align: left;
				padding: 0.55rem 0.7rem;
				border-bottom: 1px solid var(--border-soft);
			}

			th {
				font-weight: 600;
				color: var(--text-strong);
				background: var(--bg-tint);
			}

			.skip {
				position: absolute;
				left: -9999px;
			}

			.skip:focus {
				left: 1rem;
				top: 1rem;
				z-index: 20;
				background: var(--surface);
				padding: 0.5rem 0.8rem;
				border: 1px solid var(--border);
				border-radius: var(--radius-sm);
			}

			/* ───────────────────────── 顶栏 ───────────────────────── */
			.topbar {
				position: sticky;
				top: 0;
				z-index: 10;
				background: var(--bg);
				border-bottom: 1px solid var(--border-soft);
			}

			@supports (backdrop-filter: blur(10px)) {
				.topbar {
					background: color-mix(in srgb, var(--bg) 85%, transparent);
					backdrop-filter: saturate(1.4) blur(10px);
				}
			}

			.topbar-inner {
				max-width: var(--content-max);
				margin-inline: auto;
				padding: 0.85rem 1.5rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
			}

			.brand {
				font-family: var(--font-serif);
				font-size: 1.02rem;
				font-weight: 600;
				color: var(--text-strong);
				letter-spacing: 0.01em;
			}

			.brand:hover {
				text-decoration: none;
				color: var(--accent);
			}

			.topbar nav {
				display: flex;
				align-items: center;
				gap: 1.4rem;
			}

			.topbar nav a {
				font-size: 0.82rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.topbar nav a:hover {
				color: var(--text-strong);
				text-decoration: none;
			}

			.lang-btn {
				font-family: var(--font-sans);
				font-size: 0.76rem;
				letter-spacing: 0.05em;
				color: var(--muted);
				background: transparent;
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.22rem 0.65rem;
				cursor: pointer;
				transition:
					color 0.16s ease,
					border-color 0.16s ease,
					background 0.16s ease;
				min-width: 3.2rem;
			}

			.lang-btn:hover {
				color: var(--text-strong);
				border-color: var(--faint);
				background: var(--surface);
			}

			/* ───────────────────────── 骨架 ───────────────────────── */
			.shell {
				flex: 1;
				width: 100%;
				margin-inline: auto;
				padding: 2.75rem 1.5rem 4rem;
			}

			.shell--narrow {
				max-width: calc(var(--narrow-max) + 3rem);
			}

			.shell--sidebar {
				max-width: var(--content-max);
				display: grid;
				grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
				gap: 3rem;
				align-items: start;
				/* 底部留白挪到 main 上：shell 自己的 padding 在网格行之外，会缩短
				   sticky 侧栏的行程，害它在最后一屏被页脚顶着往上走。 */
				padding-bottom: 0;
			}

			.shell--sidebar main {
				padding-bottom: 4rem;
			}

			.sidebar {
				position: sticky;
				/* 必须等于侧栏在 scrollY=0 时的自然位置（顶栏 56px + .shell 顶部留白
				   2.75rem），否则从最上面往下滑时它会先跟着正文走完这段差值才吸住，
				   看起来就像在晃。改顶栏高度或 .shell 的 padding-top 都要同步改这里。 */
				top: 6.25rem;
				/* 不封顶、不内部滚动，整块完整显示。代价是窗口高度不足
				   「侧栏高 703px + 上面这个 100px」时，最后一屏它会跟着页面走一小段。 */
				overscroll-behavior: none;
			}

			.footer {
				margin-top: 3rem;
				padding-top: 1.2rem;
				border-top: 1px solid var(--border-soft);
				color: var(--faint);
				font-size: 0.82rem;
			}

			.footer p {
				margin: 0.15rem 0;
			}

			/* ───────────────────────── 区块与小件 ───────────────────────── */
			.section {
				margin-bottom: 3.25rem;
			}

			.section:last-child {
				margin-bottom: 0;
			}

			.section-head {
				display: flex;
				align-items: baseline;
				gap: 0.85rem;
				margin-bottom: 1.4rem;
			}

			.section-head h2 {
				font-size: 1.32rem;
				margin: 0;
				white-space: nowrap;
			}

			.section-head::after {
				content: '';
				flex: 1;
				height: 1px;
				background: var(--border);
			}

			.pill {
				display: inline-block;
				font-size: 0.72rem;
				letter-spacing: 0.04em;
				padding: 0.14em 0.62em;
				border-radius: 999px;
				border: 1px solid var(--border);
				color: var(--muted);
				background: var(--bg-tint);
				white-space: nowrap;
			}

			.pill--accent {
				color: var(--accent);
				border-color: color-mix(in srgb, var(--accent) 30%, transparent);
				background: var(--accent-soft);
			}

			.pill--gold {
				color: #8a6100;
				border-color: rgba(191, 149, 43, 0.4);
				background: rgba(216, 176, 74, 0.13);
			}

			@media (prefers-color-scheme: dark) {
				.pill--gold {
					color: #e2be6a;
				}
			}

			.meta {
				color: var(--muted);
				font-size: 0.86rem;
				font-variant-numeric: tabular-nums;
			}

			/* ───────────────────────── 响应式 ───────────────────────── */
			@media (max-width: 900px) {
				.shell--sidebar {
					grid-template-columns: 1fr;
					gap: 2.25rem;
				}

				.sidebar {
					position: static;
				}
			}

			@media (max-width: 560px) {
				body {
					font-size: 15.5px;
				}

				.topbar-inner {
					padding: 0.7rem 1.1rem;
					flex-wrap: wrap;
					gap: 0.6rem;
				}

				.topbar nav {
					gap: 1rem;
				}

				.topbar nav a {
					font-size: 0.76rem;
				}

				.shell {
					padding: 2rem 1.1rem 3rem;
				}

				.section {
					margin-bottom: 2.5rem;
				}

				.section-head h2 {
					font-size: 1.18rem;
				}
			}
		</style>
	</body>
</html>
